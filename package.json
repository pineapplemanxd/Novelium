{
  "name": "novelium",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Novelium — Cross-Platform macOS & Windows Novel Reader & Personal Library",
  "scripts": {
    "dev": "vite",
    "dev:ios": "node scripts/ensure-ios-sim.mjs && vite",
